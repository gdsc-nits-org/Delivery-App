<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".homepage_fragments.SearchFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"

            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EDECEB">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/arrow_back_24px"
                android:contentDescription="@string/back_button_description" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerInParent="true"
            android:text="@string/explore"
            android:textColor="#FF8000"
            android:textSize="22sp"
            android:textStyle="bold"
             android:visibility="visible"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/backButton"
            android:layout_toStartOf="@+id/searchIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"


            app:hintEnabled="false"
            app:boxBackgroundMode="none"
            android:visibility="visible"
            android:layout_alignParentEnd="true"
            android:background="@drawable/rounded_corner"
            tools:visibility="visible"

            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:hint="Search dishes or shops..."




                android:drawablePadding="8dp"

                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="50dp"
                android:textColor="#000000"
                android:textColorHint="#0B0A0A"


                android:textCursorDrawable="@null"
                app:endIconDrawable="@drawable/search"
                app:endIconMode="custom"


                app:endIconCheckable="true"/>
        </com.google.android.material.textfield.TextInputLayout>


<!--        <EditText-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:id="@+id/searchEditText"-->
<!--            android:layout_toEndOf="@id/backButton"-->
<!--            android:layout_toStartOf="@id/searchIcon"-->
<!--            android:layout_centerVertical="true"-->
<!--            android:layout_marginStart="6dp"-->
<!--            android:layout_marginEnd="8dp"-->
<!--            android:hint="Search dishes or shops..."-->
<!--            android:visibility="gone"  />-->



        <ImageView
            android:id="@+id/searchIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/search"

            android:contentDescription="@string/search_icon_description" />

    </RelativeLayout>


    <!--    </RelativeLayout>-->

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabTextColor="@color/black"
        app:tabSelectedTextColor="@color/ButtonColour"
        app:tabIndicatorColor="@color/mediumOrange"
        app:tabMode="fixed"
        app:tabGravity="fill">
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
